# Copy to .env for `npm run serve`, and add the same names in Vercel:
# Project > Settings > Environment Variables. Never commit .env.

NEAR_NETWORK=testnet
SENDAM_CONTRACT=sendam.YOUR-ACCOUNT.testnet

# The verifier account confirms paid bills. Use a separate account that holds almost nothing.
VERIFIER_ACCOUNT=verifier.YOUR-ACCOUNT.testnet
VERIFIER_PRIVATE_KEY=ed25519:...

# VTpass sandbox credentials, from your free account at sandbox.vtpass.com (Settings > API keys).
VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PHONE=08011111111

# Until your VTpass sandbox keys are active, VTPASS_MODE=simulate uses a stand-in that answers
# like the sandbox (meter 1111111111111, test tokens). Delete this line to use real VTpass.
# VTPASS_MODE=simulate
